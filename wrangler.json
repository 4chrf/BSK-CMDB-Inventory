{
  "name": "bsk-infrastructure-cmdb",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/seed.json",
      "/admin",
      "/admin/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bsk-cmdb"
    }
  ]
}
